   "source": [
    "import os\n",
    "import json\n",
    "import shutil\n",
    "import numpy as np\n",
    "import random\n",
    "\n",
    "# ---- Paths ----\n",
    "base_dir = \"/home/ubuntu/ftw_output\"\n",
    "tiff_path = os.path.join(base_dir, \"grids_tiff_matogrosso\")\n",
    "scores_path = os.path.join(base_dir, \"confidences_matogrosso\", \"confidence_scores.json\")\n",
    "\n",
    "out_lowest100 = os.path.join(base_dir, \"confidenceLowest100_matogrosso\")\n",
    "out_band100   = os.path.join(base_dir, \"confidenceLowest100_10percentband_matogrosso\")\n",
    "\n",
    "# ---- Clear and recreate output folders ----\n",
    "for folder in [out_lowest100, out_band100]:\n",
    "    if os.path.exists(folder):\n",
    "        shutil.rmtree(folder)\n",
    "    os.makedirs(folder)\n",
    "\n",
    "# ---- Load scores ----\n",
    "with open(scores_path, \"r\") as f:\n",
    "    records = json.load(f)\n",
    "\n",
    "# ---- Sort and get lowest 100 ----\n",
    "sorted_by_conf = sorted(records, key=lambda x: x[\"confidence_mean\"])\n",
    "lowest_100 = sorted_by_conf[:100]\n",
    "\n",
    "# ---- Save lowest 100 ----\n",
    "for rec in lowest_100:\n",
    "    fname = rec[\"file\"]\n",
    "    src = os.path.join(tiff_path, fname)\n",
    "    dst = os.path.join(out_lowest100, fname)\n",
    "    if os.path.exists(src):\n",
    "        shutil.copy2(src, dst)\n",
    "\n",
    "# ---- Percentile-based band (lowest 10% of chips) ----\n",
    "conf_values = np.array([r[\"confidence_mean\"] for r in records])\n",
    "percentile_10 = np.percentile(conf_values, 10)\n",
    "\n",
    "band_candidates = [r for r in records if r[\"confidence_mean\"] <= percentile_10]\n",
    "\n",
    "# Sample up to 100 from those candidates\n",
    "if len(band_candidates) > 100:\n",
    "    band_sample = random.sample(band_candidates, 100)\n",
    "else:\n",
    "    band_sample = band_candidates\n",
    "\n",
    "# ---- Save band chips ----\n",
    "for rec in band_sample:\n",
    "    fname = rec[\"file\"]\n",
    "    src = os.path.join(tiff_path, fname)\n",
    "    dst = os.path.join(out_band100, fname)\n",
    "    if os.path.exists(src):\n",
    "        shutil.copy2(src, dst)\n",
    "\n",
    "print(f\"Copied {len(lowest_100)} lowest-confidence chips to {out_lowest100}\")\n",
    "print(f\"Copied {len(band_sample)} chips from bottom 10%% confidence to {out_band100}\")\n",
    "\n"
   ]
