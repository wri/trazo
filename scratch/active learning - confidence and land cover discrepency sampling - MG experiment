    "from rasterio.mask import mask\n",
    "import rasterio\n",
    "from shapely.geometry import box, mapping\n",
    "import json\n",
    "import numpy as np\n",
    "# Read the bounding box of the original GeoTIFF\n",
    "\n",
    "geotiff_path = \"/home/aelmusta/active_learning/ftw-baselines/grids_tiff_Bolivia_5/grid_0_512.tif\"\n",
    "\n",
    "with rasterio.open(geotiff_path) as src:\n",
    "    bbox = src.bounds\n",
    "    local_crs= src.crs\n",
    "bbox_geom = box(*bbox)  # Create a polygon for the bounding box\n",
    "bbox_geom = mapping(bbox_geom)  # Converts to GeoJSON dictionary format\n",
    "\n",
    "bbox_4326 = transform_bounds(src.crs, \"EPSG:4326\", *bbox)\n",
    "# Open the STAC API for Planetary Computer\n",
    "stac = Client.open(\"https://planetarycomputer.microsoft.com/api/stac/v1\")\n",
    "# Search for data in the \"io-lulc\" collection\n",
    "search_results = stac.search(\n",
    "    collections=[\"esa-worldcover\"],  # Use the io-lulc collection\n",
    "    bbox=bbox_4326,  # Define the region of interest\n",
    "    limit=5  # Limit the number of items (adjust as needed)\n",
    ")\n",
    "\n",
    "# Get the first item from the search results\n",
    "items = list(search_results.get_items())\n",
    "item = items[0]\n",
    "\n",
    "# Get the URL for the asset (GeoTIFF)\n",
    "signed_url = pc.sign(item.assets[\"map\"].href)  # \"data\" is the GeoTIFF asset key\n",
    "\n",
    "with rasterio.open(signed_url)  as src:\n",
    "    transformed_geom = transform_geom(local_crs, src.crs, bbox_geom)\n",
    "    out_image, out_transform = mask(src, [transformed_geom], crop=True)\n",
    "\n",
    "    # Update metadata with new dimensions and transform\n",
    "    out_meta = src.meta.copy()\n",
    "    out_meta.update({\n",
    "        \"height\": out_image.shape[1],\n",
    "        \"width\": out_image.shape[2],\n",
    "        \"transform\": out_transform\n",
    "    })\n",
    "    crop_percent = np.sum(out_image[0] == 40) / (out_image.shape[1]*out_image.shape[2])\n",
    "    print(crop_percent)\n",
    "\n",
    "    # Save the cropped land cover map to a new file\n",
    "    with rasterio.open(\"cropped_land_cover_map.tif\", \"w\", **out_meta) as dst:\n",
    "        dst.write(out_image)\n",
