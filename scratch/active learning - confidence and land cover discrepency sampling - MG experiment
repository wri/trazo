    "def remove_first_duplicate(lst):\n",
    "    \"\"\"\n",
    "    Checks if a list contains a repeated value and removes the first occurrence of the duplicate.\n",
    "    \n",
    "    Args:\n",
    "        lst: The input list. \n",
    "    \n",
    "    Returns:\n",
    "        A new list with the first duplicate removed, or the original list if no duplicates were found.\n",
    "    \"\"\"\n",
    "    seen = set()\n",
    "    for i, item in enumerate(lst):\n",
    "        if item in seen:\n",
    "            del lst[i]  # Remove the first duplicate\n",
    "            return lst\n",
    "        seen.add(item)\n",
    "    return lst  # No duplicates found\n",
    "\n",
    "def run(input, model, out, resize_factor, gpu, patch_size, batch_size, padding, overwrite, mps_mode):\n",
    "    # IO related sanity checks\n",
    "    assert os.path.exists(model), f\"Model file {model} does not exist.\"\n",
    "    assert model.endswith(\".ckpt\"), \"Model file must be a .ckpt file.\"\n",
    "    assert os.path.exists(input), f\"Input file {input} does not exist.\"\n",
    "    assert os.path.isdir(input), f\"Input path {input} must be a directory containing raster files.\"\n",
    "    assert overwrite or os.path.exists(out), f\"Output file {out} already exists. Use -f to overwrite.\"\n",
    "\n",
    "    # Determine the device: GPU, MPS, or CPU\n",
    "    if mps_mode:\n",
    "        assert torch.backends.mps.is_available(), \"MPS mode is not available.\"\n",
    "        device = torch.device(\"mps\")\n",
    "    elif gpu is not None and torch.cuda.is_available():\n",
    "        device = torch.device(f\"cuda:{gpu}\")\n",
    "    else:\n",
    "        print(\"Neither GPU nor MPS mode is enabled, defaulting to CPU.\")\n",
    "        device = torch.device(\"cpu\")\n",
    "\n",
    "    # Load the input raster\n",
    "    files = sorted(glob.glob(f\"{input}/*.tif\"))\n",
    "    profiles=[]\n",
    "    transforms=[]\n",
    "    tags=[]\n",
    "    input_heights = []\n",
    "    input_widths = []\n",
    "    for i in range(len(files)):\n",
    "        with rasterio.open(files[i]) as src:\n",
    "            input_height, input_width = src.shape\n",
    "            input_heights.append(input_height)\n",
    "            input_widths.append(input_width)\n",
    "            profiles.append(src.profile)\n",
    "            profile=src.profile\n",
    "            transforms.append(profile[\"transform\"])\n",
    "            tags.append(src.tags())\n",
    "            # prev_height, prev_width = input_height, input_width\n",
    "\n",
    "    # Determine the default patch size\n",
    "\n",
    "    if patch_size is None:\n",
    "            steps = [1024, 512, 256, 128]\n",
    "            for step in steps:\n",
    "                    if step <= min(min(input_heights), min(input_widths)):\n",
    "                        patch_size = step\n",
    "                        break\n",
    "    stride = patch_size - padding * 2\n",
    "    print(\"Patch size:\", patch_size)\n",
    "\n",
    "    assert patch_size is not None, \"Input image is too small\"\n",
    "    assert patch_size % 32 == 0, \"Patch size must be a multiple of 32.\"\n",
    "    assert stride > 64, \"Patch size minus two times the padding must be greater than 64.\"\n",
    "\n",
    "    # Load task\n",
    "    tic = time.time()\n",
    "    task = CustomSemanticSegmentationTask.load_from_checkpoint(model, map_location=\"cpu\")\n",
    "    task.freeze()\n",
    "    model = task.model.eval().to(device)\n",
    "\n",
    "    if mps_mode:\n",
    "        up_sample = K.Resize((patch_size * resize_factor, patch_size * resize_factor)).to(\"cpu\")\n",
    "        down_sample = K.Resize((patch_size, patch_size), resample=Resample.NEAREST.name).to(device).to(\"cpu\")\n",
    "    else:\n",
    "        up_sample = K.Resize((patch_size * resize_factor, patch_size * resize_factor)).to(device)\n",
    "        down_sample = K.Resize((patch_size, patch_size), resample=Resample.NEAREST.name).to(device)\n",
    "\n",
    "    # dataset = SingleRasterDataset(input, transforms=preprocess)\n",
    "    dataset = BatchRasterDataset(input, transforms=preprocess)\n",
    "    # sampler = GridGeoSampler(dataset, size=patch_size, stride=stride)\n",
    "    dataloader = DataLoader(dataset, batch_size=batch_size ,num_workers=4,shuffle=False, collate_fn=stack_samples)\n",
    "\n",
    "    # Run inference\n",
    "\n",
    "\n",
    "    dl_enumerator = tqdm(dataloader)\n",
    "    output_masks = [\n",
    "        np.zeros((h, w), dtype=np.uint16) for h, w in zip(input_heights, input_widths)\n",
    "    ]\n",
    "    confidences = []\n",
    "    transform_idx =0\n",
    "    imagess = []\n",
    "    for idx,batch in enumerate(dl_enumerator):\n",
    "                images = batch[\"image\"].to(device)\n",
    "                images = up_sample(images)\n",
    "                imagess.append(images)\n",
    "                \n",
    "\n",
    "                with torch.inference_mode():\n",
    "                    \n",
    "                    predictions = model(images)\n",
    "                    confidence= predictions.softmax(dim=1)\n",
    "                    predictions = predictions.argmax(axis=1).unsqueeze(0)\n",
    "                    confidence,_=confidence.max(axis=1)\n",
    "                    confidence = confidence.cpu().numpy()\n",
    "                    predictions = down_sample(predictions.float()).int().cpu().numpy()[0]\n",
    "                for i in range(images.shape[0]):\n",
    "                    crop_percent_ftw = np.sum(predictions[i]!= 2)/(predictions[i].shape[0] * predictions[i].shape[1])\n",
    "                    with rasterio.open(files[transform_idx]) as src:\n",
    "                        bbox = src.bounds\n",
    "                    bbox_geom = box(*bbox)  # Create a polygon for the bounding box\n",
    "                    bbox_geom = mapping(bbox_geom)  # Converts to GeoJSON dictionary format\n",
    "                    local_crs=src.crs\n",
    "                    bbox_4326 = transform_bounds(src.crs, \"EPSG:4326\", *bbox)\n",
    "                    # Open the STAC API for Planetary Computer\n",
    "                    stac = Client.open(\"https://planetarycomputer.microsoft.com/api/stac/v1\")\n",
    "                    # Search for data in the \"io-lulc\" collection\n",
    "                    search_results = stac.search(\n",
    "                        collections=[\"esa-worldcover\"],\n",
    "                        bbox=bbox_4326,  # Define the region of interest\n",
    "                        limit=5  # Limit the number of items \n",
    "                    )\n",
    "                    \n",
    "                    # Get the first item from the search results\n",
    "                    items = list(search_results.get_items())\n",
    "                    item = items[1]\n",
    "                    \n",
    "                    # Get the URL for the asset (GeoTIFF)\n",
    "                    signed_url = pc.sign(item.assets[\"map\"].href)  # \"data\" is the GeoTIFF asset key\n",
    "                    # print(files[transform_idx])\n",
    "                    with rasterio.open(signed_url)  as src:\n",
    "                      \n",
    "                        transformed_geom = transform_geom(local_crs, src.crs, bbox_geom)\n",
    "                        out_image, out_transform = mask(src, [transformed_geom], crop=True)\n",
    "                    \n",
    "                        # Update metadata with new dimensions and transform\n",
    "                        out_meta = src.meta.copy()\n",
    "                        out_meta.update({\n",
    "                            \"height\": out_image.shape[1],\n",
    "                            \"width\": out_image.shape[2],\n",
    "                            \"transform\": out_transform\n",
    "                        })\n",
    "                        ESA_CROPLAND_CLASS = 40\n",
    "                        crop_percent = np.sum(out_image[0] == ESA_CROPLAND_CLASS) / (256*256)\n",
    "                    confidences.append({\n",
    "                        \"file\": files[transform_idx],  # Input file name\n",
    "                        \"patch_id\": transform_idx,  # Patch index\n",
    "                        \"confidence_mean\": float(np.mean(confidence[i])),  # Mean confidence score\n",
    "                        \"confidence_std\": float(np.std(confidence[i])),  # Mean confidence score\n",
    "                        \"metric\" : metric\n",
    "                    })\n",
    "                    output_masks[transform_idx] = predictions[i]\n",
    "                    \n",
    "                    \n",
    "                    transform_idx += 1\n",
    "                       \n",
    "    plot=np.expand_dims(output_masks[0],axis=2)\n",
    "    f, axarr = plt.subplots(2,1)\n",
    "    axarr[0].imshow(plot)\n",
    "    data=imagess[0][0].cpu().numpy()\n",
    "    x = (data[0] - data[0].min())/(data[0].max()-data[0].min())\n",
    "    y = (data[1] - data[1].min())/(data[1].max()-data[1].min())\n",
    "    z = (data[2] - data[2].min())/(data[2].max()-data[2].min())\n",
    "    img_rgb = np.dstack([x,y,z])\n",
    "    axarr[1].imshow(img_rgb)\n",
    "            # Save predictions\n",
    "    for idx, file in enumerate(files):\n",
    "        profiles[idx].update({\n",
    "                \"driver\": \"GTiff\",\n",
    "                \"count\": 1,\n",
    "                \"dtype\": \"uint8\",\n",
    "                \"compress\": \"lzw\",\n",
