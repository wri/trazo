    "                \"tiled\": True,\n",
    "                \"interleave\": \"pixel\"\n",
    "            })\n",
    "\n",
    "        output_path=os.path.join(out,file.split('/')[-1])\n",
    "        os.makedirs(os.path.dirname(output_path), exist_ok=True)\n",
    "        if os.path.exists(output_path):\n",
    "             os.remove(output_path)\n",
    "        with rasterio.open(output_path, \"w\", **profiles[idx]) as dst:\n",
    "                    dst.update_tags(**tags[idx])\n",
    "                    dst.update_tags(confidence_mean=confidences[idx][\"confidence_mean\"], confidence_std=confidences[idx][\"confidence_std\"])                    \n",
    "                    dst.write(output_masks[idx], 1)\n",
    "                    dst.write_colormap(1, {1: (255, 0, 0), 2:(0, 255, 0)})\n",
    "                    dst.colorinterp = [ColorInterp.palette]\n",
    "\n",
    "    print(f\"Finished inference and saved output to {out} in {time.time() - tic:.2f}s\")\n",
