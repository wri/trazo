    "import os\n",
    "import glob\n",
    "import json\n",
    "import numpy as np\n",
    "import rasterio\n",
    "from rasterio.warp import reproject, Resampling\n",
    "from rasterio.windows import Window\n",
    "from shapely.geometry import box, mapping\n",
    "from tqdm import tqdm\n",
    "\n",
    "# ---- Hyperparameters ----\n",
    "PIXEL_ZERO_THRESHOLD = 9830  # 15% of 256×256\n",
    "# MIN_AGRI_PIXELS      = 5461   # 1/12 of 256×256\n",
    "MIN_AGRI_PIXELS      = (1/6)*256*256   \n",
    "\n",
    "# ---- Paths ----\n",
    "out                   = \"/home/ubuntu/ftw_output/confidences_matogrosso\"\n",
    "tiff_path             = \"/home/ubuntu/ftw_output/grids_tiff_matogrosso\"\n",
    "prediction_path       = \"/home/ubuntu/ftw_output/grids_preds_matogrosso\"\n",
    "model_probabilities   = \"/home/ubuntu/ftw_output/grids_conf_matogrosso\"\n",
    "mapbiomas_ag_path     = \"/home/ubuntu/home/ubuntu/ftw-baselines/mapbiomas/brasil_mapbiomas_2020_agbin.tif\"\n",
    "export_low_conf_dir   = \"/home/ubuntu/ftw_output/low_conf_agriculture_chips\"\n",
    "\n",
    "os.makedirs(out, exist_ok=True)\n",
    "os.makedirs(export_low_conf_dir, exist_ok=True)\n",
    "\n",
    "# ---- Load file lists ----\n",
    "prediction_files = sorted(glob.glob(f\"{prediction_path}/*.tif\"))\n",
    "logits_files     = sorted(glob.glob(f\"{model_probabilities}/*.tif\"))\n",
    "chip_files       = sorted(os.listdir(tiff_path))\n",
    "\n",
    "# ---- Open MapBiomas once ----\n",
    "ag_src     = rasterio.open(mapbiomas_ag_path)\n",
    "ag_crs     = ag_src.crs\n",
    "ag_transform = ag_src.transform\n",
    "\n",
    "confidences = []\n",
    "\n",
    "# ---- Iterate Over Chips ----\n",
    "for idx, chip_name in enumerate(tqdm(chip_files, desc=\"Processing chips\", unit=\"chip\")):\n",
    "    chip_path = os.path.join(tiff_path, chip_name)\n",
    "\n",
    "    # Read the chip\n",
    "    with rasterio.open(chip_path) as src_chip:\n",
    "        chip_data    = src_chip.read()            # shape (bands,256,256)\n",
    "        chip_profile = src_chip.profile\n",
    "        chip_crs     = src_chip.crs\n",
    "        chip_bounds  = src_chip.bounds\n",
    "        h, w         = chip_data.shape[1:]        # 256,256\n",
    "\n",
    "    # 1) Filter out heavily padded chips\n",
    "    pad_pixels = np.count_nonzero(chip_data == 0)\n",
    "    if pad_pixels >= PIXEL_ZERO_THRESHOLD * chip_data.shape[0]:\n",
    "        continue\n",
    "\n",
    "    # 2) Reproject the full 256×256 mapbiomas tile into this chip's grid\n",
    "\n",
    "    dst_ag = np.zeros((h, w), dtype=ag_src.dtypes[0])\n",
    "    reproject(\n",
    "        source=rasterio.band(ag_src, 1),\n",
    "        destination=dst_ag,\n",
    "        src_transform=ag_src.transform,\n",
    "        src_crs=ag_src.crs,\n",
    "        dst_transform=chip_profile[\"transform\"],\n",
    "        dst_crs=chip_crs,\n",
    "        dst_resolution=(chip_profile[\"transform\"].a, -chip_profile[\"transform\"].e),\n",
    "        resampling=Resampling.nearest,\n",
    "    )\n",
    "    # 2.5 Resample dst_ag to match Sentinel-2 resolution using\n",
    "  \n",
    "    # 3) Build agricultural mask and filter small fields\n",
    "    ag_mask        = (dst_ag == 1)\n",
    "    ag_pixel_count = ag_mask.sum()\n",
    "    if ag_pixel_count < MIN_AGRI_PIXELS:\n",
    "        # print(f\"Skipping {chip_name} due to insufficient agricultural pixels.\")\n",
    "        continue\n",
    "\n",
    "    # 4) Load predictions & confidence\n",
    "    with rasterio.open(prediction_files[idx]) as src_pred:\n",
    "        predictions = src_pred.read(1)  # (256,256)\n",
    "    with rasterio.open(logits_files[idx]) as src_log:\n",
    "        confidence_np = src_log.read(1) # (256,256)\n",
    "\n",
    "    # 5) Compute metrics\n",
    "    ag_conf_vals     = confidence_np[ag_mask]\n",
    "    if ag_conf_vals.size == 0:\n",
    "        print(f\"Skipping {chip_name} due to no agricultural pixels in confidence map.\")\n",
    "        continue\n",
    "\n",
    "    crop_pct_mapbiomas = ag_pixel_count / (h * w)\n",
    "    crop_pct_pred      = (predictions != 0).sum() / (h * w)\n",
    "    metric             = crop_pct_mapbiomas - crop_pct_pred\n",
    "\n",
    "    confidences.append({\n",
